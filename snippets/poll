# poll <max_attempts> <delay_seconds> <command...>
# Runs <command> in a loop until it succeeds or <max_attempts> is reached.
# Prints a dot per attempt, newline on exit. Returns 0 on success, 1 on
# timeout (non-fatal — unlike retry(), the caller decides how to handle
# exhaustion).
poll() {
  poll_max_attempts="$1"
  poll_delay_seconds="$2"
  shift 2
  poll_attempt=0
  while [ "$poll_attempt" -lt "$poll_max_attempts" ]; do
    if "$@"; then
      printf '\n'
      return 0
    fi
    printf '.'
    sleep "$poll_delay_seconds"
    poll_attempt=$((poll_attempt + 1))
  done
  printf '\n'
  return 1
}
