#!/bin/sh
#
# Launch Thunar as a floating, fixed-size window with a mark set, so a
# for_window rule in the Sway config could reposition it automatically
# (see the Mark section of README.md for the pattern).
#
set -eu

print_usage() {
  printf 'Usage: %s\n' "$(basename "$0")"
  printf 'Launch Thunar floating at a fixed size, marked file-manager.\n'
}

usage() {
  if [ "${1:-0}" -ne 0 ]; then
    print_usage >&2
  else
    print_usage
  fi
  exit "${1:-0}"
}

die() {
  printf '%s✗ %s%s\n' "${COLOR_RED:-}" "$*" "${COLOR_RESET:-}" >&2
  exit 1
}

setup_colors() {
  if [ -t 1 ]; then
    COLOR_RED="$(printf '\033[0;31m')"
    COLOR_RESET="$(printf '\033[0m')"
  else
    COLOR_RED=''
    COLOR_RESET=''
  fi
}

setup_colors
readonly COLOR_RED COLOR_RESET

case "${1:-}" in
-h | --help)
  usage 0
  ;;
'') ;;
*)
  usage 1
  ;;
esac

command -v thunar >/dev/null 2>&1 || die "thunar not found on PATH. Install Thunar first."

sway-launch -a thunar --floating --width 900px --height 600px --mark file-manager thunar
