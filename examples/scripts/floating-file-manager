#!/bin/sh
#
# Launch Thunar as a floating, fixed-size window with a mark set.
#
set -eu

print_usage() {
  printf 'Usage: %s\n' "$(basename "$0")"
  printf 'Launch Thunar floating at a fixed size, marked file-manager.\n'
  printf '\n'
  printf 'The mark lets a for_window rule in the Sway config reposition it\n'
  printf 'automatically (see the Mark section of README.md for the pattern).\n'
}

usage() {
  if [ "${1:-0}" -ne 0 ]; then
    print_usage >&2
  else
    print_usage
  fi
  exit "${1:-0}"
}

die() {
  printf '✗ %s\n' "$*" >&2
  exit 1
}

case "${1:-}" in
-h | --help)
  usage 0
  ;;
'') ;;
*)
  usage 1
  ;;
esac

command -v sway-launch >/dev/null 2>&1 || die "sway-launch not found on PATH. Install sway-launch first."
command -v thunar >/dev/null 2>&1 || die "thunar not found on PATH. Install Thunar first."

# app_id/class values vary by backend and distro; see "Finding a window's app_id or class" in README.md.
exec sway-launch -a thunar --floating --width 900px --height 600px --mark file-manager thunar
