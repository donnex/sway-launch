#!/bin/sh
#
# Launch VS Code on the left and two stacked foot terminals on the right.
#
set -eu

print_usage() {
  printf 'Usage: %s\n' "$(basename "$0")"
  printf 'Launch VS Code plus a two-terminal column beside it.\n'
}

usage() {
  if [ "${1:-0}" -ne 0 ]; then
    print_usage >&2
  else
    print_usage
  fi
  exit "${1:-0}"
}

die() {
  printf '✗ %s\n' "$*" >&2
  exit 1
}

case "${1:-}" in
-h | --help)
  usage 0
  ;;
'') ;;
*)
  usage 1
  ;;
esac

command -v sway-launch >/dev/null 2>&1 || die "sway-launch not found on PATH. Install sway-launch first."
command -v code >/dev/null 2>&1 || die "code not found on PATH. Install VS Code first."

# app_id/class values vary by backend and distro; see "Finding a window's app_id or class" in README.md.
# The width goes on the first terminal rather than on VS Code: Sway ignores a resize while a window
# is still alone on its workspace, and sizing the terminal column to 35% leaves VS Code the other 65%.
sway-launch -c Code --split h code
sway-launch -a foot --split v --width 35ppt foot
exec sway-launch -a foot foot
