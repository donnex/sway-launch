#!/bin/sh
#
# Launch a dev workspace: VS Code on the left, two kitty terminals stacked
# in a column on the right.
#
set -eu

usage() {
  printf 'Usage: %s\n' "$(basename "$0")"
  printf 'Launch VS Code plus a two-terminal column beside it.\n'
}

case "${1:-}" in
-h | --help)
  usage
  exit 0
  ;;
esac

sway-launch -c Code --split h --width 65ppt code
sway-launch --new-column -a kitty --split v kitty
sway-launch -a kitty kitty
