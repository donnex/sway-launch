#!/bin/sh
#
# Launch a dev workspace: VS Code on the left, two foot terminals stacked
# in a column on the right.
#
set -eu

print_usage() {
  printf 'Usage: %s\n' "$(basename "$0")"
  printf 'Launch VS Code plus a two-terminal column beside it.\n'
}

# snippet: usage
usage() {
  if [ "${1:-0}" -ne 0 ]; then
    print_usage >&2
  else
    print_usage
  fi
  exit "${1:-0}"
}

# snippet: die
die() {
  printf '%s✗ %s%s\n' "${COLOR_RED:-}" "$*" "${COLOR_RESET:-}" >&2
  exit 1
}

case "${1:-}" in
-h | --help)
  usage 0
  ;;
'') ;;
*)
  usage 1
  ;;
esac

command -v code >/dev/null 2>&1 || die "code not found on PATH. Install VS Code first."

sway-launch -c Code --split h --width 65ppt code
sway-launch --new-column -a foot --split v foot
sway-launch -a foot foot
