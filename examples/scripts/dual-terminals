#!/bin/sh
#
# Launch two foot terminals side by side (a single row, two columns).
#
set -eu

print_usage() {
  printf 'Usage: %s\n' "$(basename "$0")"
  printf 'Launch two foot terminals side by side.\n'
}

usage() {
  if [ "${1:-0}" -ne 0 ]; then
    print_usage >&2
  else
    print_usage
  fi
  exit "${1:-0}"
}

die() {
  printf '✗ %s\n' "$*" >&2
  exit 1
}

case "${1:-}" in
-h | --help)
  usage 0
  ;;
'') ;;
*)
  usage 1
  ;;
esac

command -v sway-launch >/dev/null 2>&1 || die "sway-launch not found on PATH. Install sway-launch first."

sway-launch -a foot --split h foot
exec sway-launch -a foot foot
