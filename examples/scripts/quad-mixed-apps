#!/bin/sh
#
# Launch a 2x2 grid of four different applications: a kitty terminal,
# Firefox, Thunar, and VS Code.
#
set -eu

print_usage() {
  printf 'Usage: %s\n' "$(basename "$0")"
  printf 'Launch a 2x2 grid: kitty, Firefox, Thunar, and VS Code.\n'
}

# snippet: usage
usage() {
  if [ "${1:-0}" -ne 0 ]; then
    print_usage >&2
  else
    print_usage
  fi
  exit "${1:-0}"
}

case "${1:-}" in
-h | --help)
  usage 0
  ;;
'') ;;
*)
  usage 1
  ;;
esac

sway-launch -a kitty --split h kitty
sway-launch -a firefox --split v 'firefox --new-window https://example.com'

sway-launch --new-row -a thunar --split h thunar
sway-launch -c Code code
