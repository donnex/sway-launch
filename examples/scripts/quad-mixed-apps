#!/bin/sh
#
# Launch a 2x2 grid of foot, Firefox, Thunar, and VS Code.
#
set -eu

print_usage() {
  printf 'Usage: %s\n' "$(basename "$0")"
  printf 'Launch a 2x2 grid: foot, Firefox, Thunar, and VS Code.\n'
}

usage() {
  if [ "${1:-0}" -ne 0 ]; then
    print_usage >&2
  else
    print_usage
  fi
  exit "${1:-0}"
}

die() {
  printf '✗ %s\n' "$*" >&2
  exit 1
}

case "${1:-}" in
-h | --help)
  usage 0
  ;;
'') ;;
*)
  usage 1
  ;;
esac

command -v sway-launch >/dev/null 2>&1 || die "sway-launch not found on PATH. Install sway-launch first."

for required_command in firefox thunar code; do
  command -v "$required_command" >/dev/null 2>&1 ||
    die "$required_command not found on PATH. Install Firefox, Thunar, and VS Code first."
done

# app_id/class values vary by backend and distro; see "Finding a window's app_id or class" in README.md.
sway-launch -a foot --split h foot
sway-launch -a firefox --split v 'firefox --new-window https://example.com'

sway-launch --new-row -a thunar --split h thunar
exec sway-launch -c Code code
