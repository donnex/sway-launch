#!/bin/sh
#
# Launch a kitty terminal, then retarget it two ways without relaunching:
# first via --con-id using the captured container id, then via --existing
# matching --app-id against the already-open window.
#
set -eu

print_usage() {
  printf 'Usage: %s\n' "$(basename "$0")"
  printf 'Launch a terminal, then retarget it via --con-id and --existing.\n'
}

# snippet: usage
usage() {
  if [ "${1:-0}" -ne 0 ]; then
    print_usage >&2
  else
    print_usage
  fi
  exit "${1:-0}"
}

case "${1:-}" in
-h | --help)
  usage 0
  ;;
'') ;;
*)
  usage 1
  ;;
esac

container_id="$(sway-launch -a kitty kitty)"
sway-launch --con-id "$container_id" --floating --width 800px --height 600px
sway-launch --existing -a kitty --mark retargeted
