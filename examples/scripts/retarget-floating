#!/bin/sh
#
# Launch a foot terminal, then retarget it two ways without relaunching:
# first via --con-id using the captured container id, then via --existing
# matching --app-id against the already-open window. The terminal gets its
# own app_id, so --existing matches only it, not other open foot windows
# (such as the one running this script).
#
set -eu

readonly APP_ID='sway-launch-example'

print_usage() {
  printf 'Usage: %s\n' "$(basename "$0")"
  printf 'Launch a terminal, then retarget it via --con-id and --existing.\n'
}

usage() {
  if [ "${1:-0}" -ne 0 ]; then
    print_usage >&2
  else
    print_usage
  fi
  exit "${1:-0}"
}

case "${1:-}" in
-h | --help)
  usage 0
  ;;
'') ;;
*)
  usage 1
  ;;
esac

container_id="$(sway-launch -a "$APP_ID" "foot --app-id $APP_ID")"
sway-launch --con-id "$container_id" --floating --width 800px --height 600px
exec sway-launch --existing -a "$APP_ID" --mark retargeted
