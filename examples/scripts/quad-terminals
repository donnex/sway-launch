#!/bin/sh
#
# Launch four kitty terminals as an equally sized 2x2 grid, two rows of two.
#
set -eu

print_usage() {
  printf 'Usage: %s\n' "$(basename "$0")"
  printf 'Launch four kitty terminals as a 2x2 grid.\n'
}

# snippet: usage
usage() {
  if [ "${1:-0}" -ne 0 ]; then
    print_usage >&2
  else
    print_usage
  fi
  exit "${1:-0}"
}

case "${1:-}" in
-h | --help)
  usage 0
  ;;
'') ;;
*)
  usage 1
  ;;
esac

sway-launch -a kitty --split h kitty
sway-launch -a kitty --split v kitty

sway-launch --new-row -a kitty --split h kitty
sway-launch -a kitty kitty
