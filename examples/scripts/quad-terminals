#!/bin/sh
#
# Launch four foot terminals as an equally sized 2x2 grid, two rows of two.
#
set -eu

print_usage() {
  printf 'Usage: %s\n' "$(basename "$0")"
  printf 'Launch four foot terminals as a 2x2 grid.\n'
}

usage() {
  if [ "${1:-0}" -ne 0 ]; then
    print_usage >&2
  else
    print_usage
  fi
  exit "${1:-0}"
}

case "${1:-}" in
-h | --help)
  usage 0
  ;;
'') ;;
*)
  usage 1
  ;;
esac

sway-launch -a foot --split h foot
sway-launch -a foot --split v foot

sway-launch --new-row -a foot --split h foot
sway-launch -a foot foot
