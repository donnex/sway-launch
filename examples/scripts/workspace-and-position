#!/bin/sh
#
# Launch a floating kitty terminal, move it to workspace 2, and center it.
#
set -eu

print_usage() {
  printf 'Usage: %s\n' "$(basename "$0")"
  printf 'Launch a floating kitty terminal on workspace 2, centered.\n'
}

# snippet: usage
usage() {
  if [ "${1:-0}" -ne 0 ]; then
    print_usage >&2
  else
    print_usage
  fi
  exit "${1:-0}"
}

case "${1:-}" in
-h | --help)
  usage 0
  ;;
'') ;;
*)
  usage 1
  ;;
esac

sway-launch -a kitty --floating --workspace 2 --position center kitty
