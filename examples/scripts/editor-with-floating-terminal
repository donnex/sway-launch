#!/bin/sh
#
# Launch VS Code full-width, then a small floating foot terminal on top of
# it for quick one-off commands.
#
set -eu

print_usage() {
  printf 'Usage: %s\n' "$(basename "$0")"
  printf 'Launch VS Code plus a small floating quick-terminal on top.\n'
}

usage() {
  if [ "${1:-0}" -ne 0 ]; then
    print_usage >&2
  else
    print_usage
  fi
  exit "${1:-0}"
}

die() {
  printf '%s✗ %s%s\n' "${COLOR_RED:-}" "$*" "${COLOR_RESET:-}" >&2
  exit 1
}

case "${1:-}" in
-h | --help)
  usage 0
  ;;
'') ;;
*)
  usage 1
  ;;
esac

command -v code >/dev/null 2>&1 || die "code not found on PATH. Install VS Code first."

sway-launch -c Code code
sway-launch -a foot --floating --width 700px --height 450px foot
