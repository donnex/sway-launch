#!/bin/sh
#
# Launch Firefox and Chromium side by side, both on example.com, for
# comparing how a page renders in each.
#
set -eu

print_usage() {
  printf 'Usage: %s\n' "$(basename "$0")"
  printf 'Launch Firefox and Chromium side by side on example.com.\n'
}

usage() {
  if [ "${1:-0}" -ne 0 ]; then
    print_usage >&2
  else
    print_usage
  fi
  exit "${1:-0}"
}

die() {
  printf '✗ %s\n' "$*" >&2
  exit 1
}

case "${1:-}" in
-h | --help)
  usage 0
  ;;
'') ;;
*)
  usage 1
  ;;
esac

for required_command in firefox chromium; do
  command -v "$required_command" >/dev/null 2>&1 ||
    die "$required_command not found on PATH. Install Firefox and Chromium first."
done

sway-launch -a firefox --split h 'firefox --new-window https://example.com'
sway-launch -a chromium 'chromium --new-window https://example.com'
