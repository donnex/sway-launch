#!/bin/sh
#
# Launch two kitty terminals stacked in a single column (one above the other).
#
set -eu

usage() {
  printf 'Usage: %s\n' "$(basename "$0")"
  printf 'Launch two kitty terminals stacked in a single column.\n'
}

case "${1:-}" in
-h | --help)
  usage
  exit 0
  ;;
esac

sway-launch -a kitty --split v kitty
sway-launch -a kitty kitty
