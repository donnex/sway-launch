#!/bin/sh
#
# Run tests/live_sway.rs against a throwaway headless Sway compositor.
#
set -eu

print_usage() {
  printf 'Usage: %s\n' "$(basename "$0")"
  printf 'Run the live-Sway integration test suite (tests/live_sway.rs) against\n'
  printf 'a throwaway headless Sway compositor.\n'
  printf '\n'
  printf 'Requires sway, swaymsg, foot, and cargo on PATH.\n'
}

die() {
  printf '✗ %s\n' "$*" >&2
  exit 1
}

usage() {
  if [ "${1:-0}" -ne 0 ]; then
    print_usage >&2
  else
    print_usage
  fi
  exit "${1:-0}"
}

poll() {
  poll_max_attempts="$1"
  poll_delay_seconds="$2"
  shift 2
  poll_attempt=0
  while [ "$poll_attempt" -lt "$poll_max_attempts" ]; do
    if "$@"; then
      printf '\n'
      return 0
    fi
    printf '.'
    sleep "$poll_delay_seconds"
    poll_attempt=$((poll_attempt + 1))
  done
  printf '\n'
  return 1
}

case "${1:-}" in
-h | --help)
  usage 0
  ;;
'') ;;
*)
  usage 1
  ;;
esac

for required_command in sway swaymsg foot cargo; do
  command -v "$required_command" >/dev/null 2>&1 ||
    die "$required_command not found on PATH. Install sway, foot, and a Rust toolchain first."
done

# Printed so a CI log records which Sway a run tested: the newest-Sway job
# installs whatever its rolling distribution ships that day.
sway_version="$(sway --version)" || die 'Could not read the Sway version.'
printf '%s\n' "$sway_version"

readonly FAILURE_LOG_LINES=50

sway_pid=''
sway_runtime_dir=''

cleanup() {
  [ -n "$sway_pid" ] && kill "$sway_pid" >/dev/null 2>&1
  [ -n "$sway_pid" ] && wait "$sway_pid" 2>/dev/null
  [ -n "$sway_runtime_dir" ] && rm -rf "$sway_runtime_dir"
}
trap cleanup EXIT
# POSIX sh doesn't run an EXIT trap on an unhandled signal, so without these
# an interrupted run leaves the headless compositor and its runtime dir behind.
trap 'exit 130' INT
trap 'exit 143' TERM

# A Unix socket path is limited to about 100 bytes, and Sway puts its IPC
# socket in XDG_RUNTIME_DIR, so the directory goes under /tmp rather than a
# possibly long TMPDIR (#130).
sway_runtime_dir="$(mktemp -d -p /tmp)"

printf 'Starting headless Sway\n'
env \
  WLR_BACKENDS=headless \
  WLR_RENDERER=pixman \
  WLR_LIBINPUT_NO_DEVICES=1 \
  XDG_RUNTIME_DIR="$sway_runtime_dir" \
  sway -c /dev/null >"$sway_runtime_dir/sway.log" 2>&1 &
sway_pid="$!"

sway_socket="$sway_runtime_dir/sway-ipc.$(id -u).$sway_pid.sock"

# Sway exports I3SOCK as well as SWAYSOCK to everything it spawns, so inside a
# desktop session both name the real compositor. Overriding SWAYSOCK alone
# would leave anything that reads I3SOCK first (swayipc's Connection::new())
# driving the desktop, so both are pointed at the headless instance. The
# sentinel is what tests/live_sway.rs refuses to run without, so a plain
# `cargo test --all-features` can't reach a real session either.
export SWAYSOCK="$sway_socket"
export I3SOCK="$sway_socket"
export SWAY_LAUNCH_LIVE_TESTS_SOCKET="$sway_socket"

sway_ipc_ready() {
  swaymsg -t get_version >/dev/null 2>&1
}

printf 'Waiting for the Sway IPC socket '
if ! poll 50 0.1 sway_ipc_ready; then
  cat "$sway_runtime_dir/sway.log" >&2
  die "Timed out waiting for headless Sway to become ready."
fi

# Derived from Sway's own runtime dir rather than assumed as "wayland-1" —
# which display number a fresh, isolated XDG_RUNTIME_DIR headless Sway
# instance picks is Sway's own choice, not something this script controls.
wayland_display=''
for wayland_socket in "$sway_runtime_dir"/wayland-*; do
  case "$wayland_socket" in
  *.lock) continue ;;
  esac
  [ -S "$wayland_socket" ] && wayland_display="$(basename "$wayland_socket")"
done
[ -n "$wayland_display" ] || die "Could not find a Wayland display socket under $sway_runtime_dir."

printf 'Running live-Sway tests\n'
if XDG_RUNTIME_DIR="$sway_runtime_dir" \
  WAYLAND_DISPLAY="$wayland_display" \
  cargo test --locked --features live-sway-tests --test live_sway -- --test-threads=1; then
  printf '✓ Live-Sway tests passed\n'
else
  # The runtime dir, and Sway's log with it, is removed on exit, and a
  # compositor that crashed mid-run shows up only as every later test's IPC
  # error, so its state and the log's tail go into the output first (#184).
  if kill -0 "$sway_pid" 2>/dev/null; then
    printf '\nSway is still running.\n' >&2
  else
    printf '\nSway is no longer running: it exited or crashed during the tests.\n' >&2
  fi
  printf -- '--- Last %s lines of the Sway log ---\n' "$FAILURE_LOG_LINES" >&2
  tail -n "$FAILURE_LOG_LINES" "$sway_runtime_dir/sway.log" >&2 ||
    printf '(could not read the Sway log)\n' >&2
  printf -- '--- End of the Sway log ---\n' >&2
  die "Live-Sway tests failed."
fi
