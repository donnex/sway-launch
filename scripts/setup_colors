# setup_colors
# Detects whether stdout is a terminal and sets COLOR_* variables to ANSI
# escape sequences, or to empty strings otherwise. Call once near the top
# of the script, then typically:
#   setup_colors
#   # shellcheck disable=SC2034
#   readonly COLOR_BOLD COLOR_DIM COLOR_GREEN COLOR_YELLOW COLOR_RED COLOR_CYAN COLOR_MAGENTA COLOR_RESET
# Not every script uses every color — the shellcheck disables (on both the
# function and the readonly line) cover the resulting unused-variable
# warnings so the function stays identical across scripts regardless of
# which colors they actually use.
# shellcheck disable=SC2034
setup_colors() {
  if [ -t 1 ]; then
    COLOR_BOLD="$(printf '\033[1m')"
    COLOR_DIM="$(printf '\033[2m')"
    COLOR_GREEN="$(printf '\033[0;32m')"
    COLOR_YELLOW="$(printf '\033[1;33m')"
    COLOR_RED="$(printf '\033[0;31m')"
    COLOR_CYAN="$(printf '\033[0;36m')"
    COLOR_MAGENTA="$(printf '\033[0;35m')"
    COLOR_RESET="$(printf '\033[0m')"
  else
    COLOR_BOLD=''
    COLOR_DIM=''
    COLOR_GREEN=''
    COLOR_YELLOW=''
    COLOR_RED=''
    COLOR_CYAN=''
    COLOR_MAGENTA=''
    COLOR_RESET=''
  fi
}
